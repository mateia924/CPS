# Copy this file to .env.staging and fill in real values before running
# infra/docker-compose.staging.yml. Never commit the real .env.staging.
#
# Staging is a full, independent stack (own Postgres/Redis/MinIO,
# compose project "cps-staging") on port 3001 — never share secrets
# with the real .env (the local/live stack on 3000) or .env's dev
# sandbox equivalents. Generate every secret below fresh, the same way
# .env.example says to for the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-host-ip
DJANGO_TIME_ZONE=UTC
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://your-host-ip:3001
PLATFORM_JWT_SIGNING_KEY=change-me-generate-a-different-secret-than-django-secret-key
PLATFORM_JWT_ACCESS_MINUTES=30
PLATFORM_JWT_REFRESH_DAYS=7

# --- PostgreSQL (staging's own instance/volume) ---
POSTGRES_DB=cps_staging
POSTGRES_USER=cps_staging
POSTGRES_PASSWORD=change-me
# Sprint 6.6.3 (item 1): same restricted RLS-bound role as .env.example —
# see its own comment there.
POSTGRES_APP_USER=cps_staging_app
POSTGRES_APP_PASSWORD=change-me-different-than-postgres-password

# --- Frontend (baked in at image build time) ---
NEXT_PUBLIC_API_URL=http://your-host-ip:3001/api
NEXT_PUBLIC_APP_DOMAIN=localhost:3001

# --- Attachments: MinIO + ClamAV (staging's own bucket/instance) ---
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-at-least-8-chars
MINIO_BUCKET=cps-attachments-staging
MINIO_ENDPOINT_URL=http://minio:9000
ATTACHMENT_LINK_SIGNING_KEY=change-me-generate-a-different-secret-again
CLAMD_HOST=clamav
CLAMD_PORT=3310
ATTACHMENT_SCAN_ENABLED=true
ATTACHMENT_DEFAULT_MAX_FILE_MB=20
CPS_BACKUP_CLOUD_BUCKET=

# --- Infra ---
STAGING_HTTP_PORT=3001

# Sprint 6.6.0 (staging_refresh.sh): every user's password on staging
# gets rewritten to this single, known value after each refresh — real
# emails are left untouched.
STAGING_UAT_PASSWORD=change-me-pick-a-known-uat-password
