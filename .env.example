# Copy this file to .env and fill in real values before running Docker
# Compose. Never commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=false
# 154.41.209.222 is this dev host's public IP, added so the app is
# reachable from the internet at http://154.41.209.222:3000. Replace
# with your own host's address (or drop it) on a different machine.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,154.41.209.222
DJANGO_TIME_ZONE=UTC
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://154.41.209.222:3000
# Sprint 2 (docs/SYSTEM_ANALYSIS.md 3.14): signing key for platform
# (Super Admin) auth tokens — must be a DIFFERENT secret from
# DJANGO_SECRET_KEY above, so a platform token and a customer token can
# never verify against each other's key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
PLATFORM_JWT_SIGNING_KEY=change-me-generate-a-different-secret-than-django-secret-key
PLATFORM_JWT_ACCESS_MINUTES=30
PLATFORM_JWT_REFRESH_DAYS=7

# --- PostgreSQL ---
POSTGRES_DB=cps
POSTGRES_USER=cps
POSTGRES_PASSWORD=change-me
# DATABASE_URL is composed automatically in infra/docker-compose.yml from
# the three POSTGRES_* values above; only override it if you're pointing
# the backend at a database outside the compose network.

# --- Redis / Celery ---
# REDIS_URL is set automatically in infra/docker-compose.yml (redis:6379/0).

# --- Attachments: MinIO (S3-compatible) + ClamAV — sprint 5.1 (3.17) ---
# MinIO credentials — generate real ones, never reuse across environments.
# Access is internal-only (no published port); Django talks to it as
# "minio:9000" inside the compose network, never presigned/exposed
# directly to browsers (all uploads/downloads proxy through Django).
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-at-least-8-chars
MINIO_BUCKET=cps-attachments
MINIO_ENDPOINT_URL=http://minio:9000
# HMAC secret for the app's own signed download links (5-minute expiry,
# apps/attachments/services.py) — separate from DJANGO_SECRET_KEY on the
# same principle as PLATFORM_JWT_SIGNING_KEY above. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
ATTACHMENT_LINK_SIGNING_KEY=change-me-generate-a-different-secret-again
# clamd — internal only, no published port. Dev-only escape hatch (a
# container without it just skips scanning, marking files SKIPPED
# instead of CLEAN); production refuses to start with this set to
# false — see apps/attachments/apps.py.
CLAMD_HOST=clamav
CLAMD_PORT=3310
ATTACHMENT_SCAN_ENABLED=true
# Per-file size ceiling used only when a plan has no max_file_mb of its
# own (should be rare — the plan's own limit is the real one).
ATTACHMENT_DEFAULT_MAX_FILE_MB=20
# OCI Object Storage destination for scripts/backup.sh's future
# attachments-bucket sync — unset until that administrative decision is
# made (docs/CFO_REVIEW_1.md O1); see scripts/backup.sh.
CPS_BACKUP_CLOUD_BUCKET=

# --- Frontend ---
# Base URL the browser uses to reach the API. With the bundled nginx
# reverse proxy this is the same origin the app is served from, at /api.
# Baked in at frontend build time — rebuild the frontend after changing
# this.
NEXT_PUBLIC_API_URL=http://154.41.209.222:3000/api

# --- Infra (dev) ---
# This host is dev-only. Ports 80/443 (system nginx), 8080 (Oracle ORDS)
# and others are already taken by other production services on this
# machine — see README "Reserved ports on this host". The dev stack
# (infra/docker-compose.yml + docker-compose.dev.yml) always uses 3000;
# do not change this on this host.
HTTP_PORT=3000

# --- Infra (prod — used only by infra/docker-compose.prod.yml, not yet
# deployed; this host never runs it) ---
# Domain the production nginx serves and requests a Let's Encrypt cert
# for. Placeholder only until a production host exists.
DOMAIN_NAME=example.com
CERTBOT_EMAIL=admin@example.com

# Sprint 6.8 (decision 17): SMTP for the daily pending-approvals digest
# email — unset means the backend/celery_worker containers use Django's
# console backend (prints to the container log, never a real send).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@cps-erp.com
# The link inside that digest email points here (the frontend), not at
# the API. Dev default is this host's own frontend port.
FRONTEND_BASE_URL=http://localhost:3000
