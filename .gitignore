# Environment
.env
.env.*
!.env.example
# Sprint 6.6.5 (CI #46): committed on purpose — recognizable test
# values only, never real secrets, used only by the e2e job/`make e2e`.
!.env.ci
.env.local

# Python
__pycache__/
*.pyc
*.sqlite3
backend/staticfiles/
backend/.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts.bak
frontend/tsconfig.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store

# Docker
infra/*.log

# Backups / dumps / secrets — never committed, regardless of location
backups/
*.sql
*.sql.gz
*.dump
*.bak
media/
node_modules/
.next/

# Sprint 7.2.8 (2026-10-10): defensive pattern only — the real
# Hostinger DNS API token file lives entirely outside this repo tree
# (/etc/cps-secrets/, root:root 600), so this entry has no effect on
# it. Added anyway, before the file exists, in case anyone ever
# creates a local copy or symlink under the repo by mistake.
secrets/
*hostinger*token*
*.token

# E2E (sprint 6.5.8) — browser session/token state and Playwright's own
# run artifacts, never the spec files or config themselves.
frontend/e2e/.auth/
frontend/e2e/test-results/
frontend/e2e/playwright-report/
frontend/e2e/tsconfig.tsbuildinfo
# Sprint 6.6.3c: `npx playwright test` from frontend/ (rather than
# frontend/e2e/) resolves its default outputDir here instead.
frontend/test-results/
