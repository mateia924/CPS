# Production nginx config. Mounted as an nginx *.template file; the
# official nginx image's entrypoint runs envsubst on it automatically at
# container start, substituting ${DOMAIN_NAME} from the container
# environment (set in docker-compose.prod.yml) into
# /etc/nginx/conf.d/default.conf.
#
# BOOTSTRAP NOTE (see README "نشر الإنتاج لاحقًا"): on a brand-new prod
# host there is no certificate yet at the ssl_certificate path below, so
# nginx will fail to start with this file as-is. The standard fix is a
# two-step bootstrap: (1) temporarily comment out the `listen 443` server
# block and start nginx with only the port-80 block (which also serves
# the ACME challenge), (2) run certbot against the running webroot to
# obtain the first certificate, (3) uncomment the 443 block and reload.
# Subsequent renewals just need `certbot renew` + an nginx reload — no
# more manual edits.

upstream backend {
    server backend:8000;
}

upstream frontend {
    server frontend:3000;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    client_max_body_size 20M;

    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        alias /usr/share/nginx/static/;
    }

    location / {
        proxy_pass http://frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
