# Sprint 6.6.5 (CI #46): the e2e job's OWN committed env file — never
# real secrets (this whole file is checked into the repo, readable by
# anyone), just recognizable, non-"change-me" test values so a future
# reader (or scripts/deploy.sh's own placeholder-fingerprint guard, if
# it's ever generalized beyond the real .env it checks today) can tell
# at a glance this was never meant to protect anything real. Never
# used for the backend/frontend jobs (those run natively, no .env at
# all — see ci.yml) — only `make e2e` (docker-compose-based, closer to
# a real deployment) still needs a real env file to boot the stack.

# --- Django ---
DJANGO_SECRET_KEY=ci-test-django-secret-key-never-used-outside-github-actions
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3002
PLATFORM_JWT_SIGNING_KEY=ci-test-platform-jwt-signing-key-never-used-outside-github-actions
PLATFORM_JWT_ACCESS_MINUTES=30
PLATFORM_JWT_REFRESH_DAYS=7

# --- PostgreSQL ---
POSTGRES_DB=cps
POSTGRES_USER=cps
POSTGRES_PASSWORD=ci-test-postgres-password
POSTGRES_APP_USER=cps_app
POSTGRES_APP_PASSWORD=ci-test-postgres-app-password

# --- Attachments: MinIO (S3-compatible) + ClamAV — sprint 5.1 (3.17) ---
MINIO_ACCESS_KEY=ci-test-minio-access-key
MINIO_SECRET_KEY=ci-test-minio-secret-key
MINIO_BUCKET=cps-attachments
MINIO_ENDPOINT_URL=http://minio:9000
ATTACHMENT_LINK_SIGNING_KEY=ci-test-attachment-link-signing-key
CLAMD_HOST=clamav
CLAMD_PORT=3310
ATTACHMENT_SCAN_ENABLED=true
ATTACHMENT_DEFAULT_MAX_FILE_MB=20
# scripts/backup.sh isn't exercised by `make e2e` at all, but every
# required-secret var deploy.sh's guard enumerates needs a real
# (non-"change-me") value here on principle, same reasoning as above.
CPS_BACKUP_ENCRYPTION_PASSPHRASE=ci-test-backup-encryption-passphrase
CPS_BACKUP_CLOUD_BUCKET=
CPS_BACKUP_CLOUD_ENDPOINT_URL=
CPS_BACKUP_CLOUD_ACCESS_KEY=
CPS_BACKUP_CLOUD_SECRET_KEY=
CPS_BACKUP_CLOUD_REGION=us-ashburn-1
CPS_BACKUP_MINIO_BUCKET=cps-backups-interim

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_APP_DOMAIN=localhost:3002

# --- Infra (local — unused by `make e2e`, kept so every var the base
# compose file interpolates has a value) ---
HTTP_PORT=3000

# --- Infra (interactive dev sandbox — what `make e2e` actually
# brings up, same stack/ports as a human's own `make dev-up`) ---
DEV_HTTP_PORT=3002
DEV_NEXT_PUBLIC_API_URL=http://localhost:3002/api
DEV_NEXT_PUBLIC_APP_DOMAIN=localhost:3002

DOMAIN_NAME=example.com
CERTBOT_EMAIL=admin@example.com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@cps-erp.com
FRONTEND_BASE_URL=http://localhost:3002

# Sprint 6.6.5 (CI #46): tags this env file's own runtime so
# config/settings.py's CPS_ENVIRONMENT-aware checks (none currently
# gate on "ci" specifically) and any future one can tell this is a
# disposable GitHub Actions run, never staging/production.
CPS_ENVIRONMENT=ci
